{"meta": {"title": "CGL 2026 Tier 2 Mock 9 - Hindi", "id": "cgl-2026-tier2-mock9-hindi", "total_questions": 130, "correct_score": "1", "negative_score": "1", "timer_minutes": "120", "timer_seconds": 7200}, "questions": [{"answer": "1", "correct_score": "1", "deleted": "0", "difficulty_level": "0", "id": "50021", "negative_score": "1", "option_1": {"en": "<p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">0.312</span></p>", "hi": ""}, "option_2": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">0.36</span></p>", "hi": ""}, "option_3": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">0.432</span></p>", "hi": ""}, "option_4": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">0.2472</span></p>", "hi": ""}, "option_5": "", "option_image_1": "", "option_image_2": "", "option_image_3": "", "option_image_4": "", "option_image_5": "", "question": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Simplify: 0.6 of [√0.0144 + (0.3)² ÷ 0.15] − 0.25% of 48</span></p>", "hi": ""}, "question_image": "", "quiz_id": "cgl-2026-tier2-mock9-hindi", "solution_heading": "", "solution_image": "", "solution_text": {"en": "  <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"text-decoration:underline;font-family:'Cambria Math'\">Rule — BODMAS: brackets first, then 'of', then division and multiplication, then subtraction.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"text-decoration:underline;font-family:'Cambria Math'\">Inside the bracket.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">√0.0144 = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">0.12</span><span style=\"font-family:'Cambria Math'\"> (since 0.12 × 0.12 = 0.0144)</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">(0.3)² = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">0.09</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image045.png\" width=\"183\" height=\"38\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image046.png\" width=\"218\" height=\"21\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image047.png\" width=\"69\" height=\"21\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image048.png\" width=\"246\" height=\"21\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image049.png\" width=\"146\" height=\"21\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image050.png\" width=\"244\" height=\"38\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image051.png\" width=\"62\" height=\"21\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image052.png\" width=\"165\" height=\"21\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image053.png\" width=\"102\" height=\"21\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-style:italic;font-family:'Cambria Math'\">√0.0144 is 0.12, not 0.012 — count decimal places: four places under the root give two outside.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"text-decoration:underline;font-family:'Cambria Math'\">PYQ:</span><span style=\"font-family:'Cambria Math'\"> Similar question asked in </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">SSC Selection Post Phase XIV (Matriculation Level, 19 Sep 2026)</span><span style=\"font-family:'Cambria Math'\"> with different values.</span></p>", "hi": ""}, "solution_video": "", "sortingparam": "0.00"}, {"answer": "3", "correct_score": "1", "deleted": "0", "difficulty_level": "0", "id": "50022", "negative_score": "1", "option_1": {"en": "<p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">₹12,000</span></p>", "hi": ""}, "option_2": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">₹14,000</span></p>", "hi": ""}, "option_3": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">₹28,000</span></p>", "hi": ""}, "option_4": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">₹42,000</span></p>", "hi": ""}, "option_5": "", "option_image_1": "", "option_image_2": "", "option_image_3": "", "option_image_4": "", "option_image_5": "", "question": {"en": "  <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">A, B and C start a business. A invests 28 </span><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image054.png\" width=\"7\" height=\"29\" alt style=\"vertical-align:middle\" ><span style=\"font-family:'Cambria Math'\">% of the total capital, B invests 60% of the remaining capital and C invests the rest. A and B keep their money in the business for the whole year, but C joins after 6 months. Out of a total annual profit of ₹84,000, by how much does B's share exceed C's share?</span></p>", "hi": ""}, "question_image": "", "quiz_id": "cgl-2026-tier2-mock9-hindi", "solution_heading": "", "solution_image": "", "solution_text": {"en": "  <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image055.png\" width=\"366\" height=\"21\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image056.png\" width=\"322\" height=\"21\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image057.png\" width=\"282\" height=\"38\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image058.png\" width=\"180\" height=\"38\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image059.png\" width=\"196\" height=\"38\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image060.png\" width=\"110\" height=\"38\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image061.png\" width=\"219\" height=\"21\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image062.png\" width=\"118\" height=\"21\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">A : B : C = 2 × 12 : 3 × 12 : 2 × 6</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">= 24 : 36 : 12 = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">2 : 3 : 1</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"text-decoration:underline;font-family:'Cambria Math'\">Share the profit.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Total parts = 2 + 3 + 1 = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">6</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">One part = 84,000 ÷ 6 = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">₹14,000</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">B − C = (3 − 1) parts = 2 × 14,000 = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">₹28,000</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Answer: </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">₹28,000</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-style:italic;font-family:'Cambria Math'\">Leaving out C's 6 months gives 2 : 3 : 2 and only ₹12,000 — the time factor is the whole point of the question.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"text-decoration:underline;font-family:'Cambria Math'\">PYQ:</span><span style=\"font-family:'Cambria Math'\"> Similar question asked in </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">SSC CGL 2018 Mains (Tier-II)</span><span style=\"font-family:'Cambria Math'\"> and </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">SSC Selection Post Phase XIV (Higher Secondary Level, 19 Sep 2026)</span><span style=\"font-family:'Cambria Math'\"> with different values.</span></p>", "hi": ""}, "solution_video": "", "sortingparam": "0.00"}, {"answer": "4", "correct_score": "1", "deleted": "0", "difficulty_level": "0", "id": "50023", "negative_score": "1", "option_1": {"en": "<p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">525 cm²</span></p>", "hi": ""}, "option_2": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">600 cm²</span></p>", "hi": ""}, "option_3": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">400 cm²</span></p>", "hi": ""}, "option_4": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">375 cm²</span></p>", "hi": ""}, "option_5": "", "option_image_1": "", "option_image_2": "", "option_image_3": "", "option_image_4": "", "option_image_5": "", "question": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">In quadrilateral ABCD, ∠BAD = 90°, AB = 15 cm and AD = 20 cm. CM is perpendicular to the diagonal BD and CM = 18 cm. What is the area of the quadrilateral ABCD?</span></p>", "hi": ""}, "question_image": "", "quiz_id": "cgl-2026-tier2-mock9-hindi", "solution_heading": "", "solution_image": "", "solution_text": {"en": "  <p style=\"margin-top:2pt;margin-bottom:3pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image063.png\" width=\"188\" height=\"223\" alt ></p><p style=\"margin-top:0pt;margin-left:36pt;margin-bottom:1pt;text-indent:-36pt;font-size:12pt\"><span style=\"text-decoration:underline;font-family:'Cambria Math'\">The diagonal BD splits ABCD into two triangles on the same base BD.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Area = ½ × BD × (AL + CM), where AL and CM are the perpendiculars to BD.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"text-decoration:underline;font-family:'Cambria Math'\">Diagonal BD.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">△ABD is right-angled at A:</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">BD = √(15² + 20²) = √625 = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">25 cm</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"text-decoration:underline;font-family:'Cambria Math'\">Perpendicular from A.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">AL × BD = AB × AD</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">AL = 15 × 20 ÷ 25 = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">12 cm</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"text-decoration:underline;font-family:'Cambria Math'\">Area.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Area = ½ × 25 × (12 + 18)</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">= ½ × 25 × 30 = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">375 cm²</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Answer: </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">375 cm²</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-style:italic;font-family:'Cambria Math'\">Area of △ABD is ½ × 15 × 20 = 150, not 15 × 20 = 300 — the half is the slip that produces 525 cm².</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"text-decoration:underline;font-family:'Cambria Math'\">PYQ:</span><span style=\"font-family:'Cambria Math'\"> Similar question asked in </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">SSC CGL 2024 Mains (Tier-II)</span><span style=\"font-family:'Cambria Math'\"> and </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">SSC CGL 2021 Mains (Tier-II)</span><span style=\"font-family:'Cambria Math'\"> with different values.</span></p>", "hi": ""}, "solution_video": "", "sortingparam": "0.00"}, {"answer": "3", "correct_score": "1", "deleted": "0", "difficulty_level": "0", "id": "50024", "negative_score": "1", "option_1": {"en": "<p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">8√3</span></p>", "hi": ""}, "option_2": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">12</span></p>", "hi": ""}, "option_3": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">14</span></p>", "hi": ""}, "option_4": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">7</span></p>", "hi": ""}, "option_5": "", "option_image_1": "", "option_image_2": "", "option_image_3": "", "option_image_4": "", "option_image_5": "", "question": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">What is the value of tan² 75° + tan² 15°?</span></p>", "hi": ""}, "question_image": "", "quiz_id": "cgl-2026-tier2-mock9-hindi", "solution_heading": "", "solution_image": "", "solution_text": {"en": "  <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Rule — tan(A ± B) = (tan A ± tan B)/(1 ∓ tan A tan B).</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image064.png\" width=\"190\" height=\"21\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image065.png\" width=\"148\" height=\"75\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image066.png\" width=\"334\" height=\"44\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image067.png\" width=\"190\" height=\"21\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image068.png\" width=\"195\" height=\"21\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image069.png\" width=\"110\" height=\"21\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image070.png\" width=\"294\" height=\"21\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image071.png\" width=\"168\" height=\"21\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image072.png\" width=\"78\" height=\"21\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Short trick.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">tan 75° + tan 15° = 4 and tan 75° × tan 15° = 1</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">tan² 75° + tan² 15° = 4² − 2 × 1 = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">14</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Answer: </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">14</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-style:italic;font-family:'Cambria Math'\">tan 75° and tan 15° are reciprocals (tan 15° = cot 75°), so their product is 1 — that makes the square-sum a one-line job.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"text-decoration:underline;font-family:'Cambria Math'\">PYQ:</span><span style=\"font-family:'Cambria Math'\"> Similar question asked in </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">SSC CHSL 2025 Tier-I (18 Nov 2025, Shift 2)</span><span style=\"font-family:'Cambria Math'\"> with different values.</span></p>", "hi": ""}, "solution_video": "", "sortingparam": "0.00"}, {"answer": "2", "correct_score": "1", "deleted": "0", "difficulty_level": "0", "id": "50025", "negative_score": "1", "option_1": {"en": "<p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">60 litres</span></p>", "hi": ""}, "option_2": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">48 litres</span></p>", "hi": ""}, "option_3": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">36 litres</span></p>", "hi": ""}, "option_4": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">40 litres</span></p>", "hi": ""}, "option_5": "", "option_image_1": "", "option_image_2": "", "option_image_3": "", "option_image_4": "", "option_image_5": "", "question": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">A vessel contains 60 litres of a milk–water mixture in which water is 20%. 12 litres of the mixture is drawn off and replaced with water. How many litres of pure milk must now be added so that water again forms 20% of the mixture?</span></p>", "hi": ""}, "question_image": "", "quiz_id": "cgl-2026-tier2-mock9-hindi", "solution_heading": "", "solution_image": "", "solution_text": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Start.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Water = 20% of 60 = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">12 L</span><span style=\"font-family:'Cambria Math'\">, milk = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">48 L</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Draw off 12 L of mixture.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">It carries away water 20% of 12 = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">2.4 L</span><span style=\"font-family:'Cambria Math'\"> and milk </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">9.6 L</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Water left = 12 − 2.4 = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">9.6 L</span><span style=\"font-family:'Cambria Math'\">, milk left = 48 − 9.6 = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">38.4 L</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Replace with 12 L of water.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Water = 9.6 + 12 = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">21.6 L</span><span style=\"font-family:'Cambria Math'\">, total still </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">60 L</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Rule — adding pure milk leaves the water unchanged; only the total grows.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Water must be 20% of the new total:</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">21.6 = 20% of (60 + x)</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">60 + x = 21.6 × 5 = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">108</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">x = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">48 L</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Answer: </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">48 litres</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-style:italic;font-family:'Cambria Math'\">Taking water as 12 + 12 = 24 L forgets that the drawn-off mixture also removed water, and leads to 60 L.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"text-decoration:underline;font-family:'Cambria Math'\">PYQ:</span><span style=\"font-family:'Cambria Math'\"> Similar question asked in </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">SSC CGL 2022 Mains (Tier-II)</span><span style=\"font-family:'Cambria Math'\"> with different values.</span></p>", "hi": ""}, "solution_video": "", "sortingparam": "0.00"}, {"answer": "1", "correct_score": "1", "deleted": "0", "difficulty_level": "0", "id": "50026", "negative_score": "1", "option_1": {"en": "<p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">168</span></p>", "hi": ""}, "option_2": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">192</span></p>", "hi": ""}, "option_3": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">144</span></p>", "hi": ""}, "option_4": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">210</span></p>", "hi": ""}, "option_5": "", "option_image_1": "", "option_image_2": "", "option_image_3": "", "option_image_4": "", "option_image_5": "", "question": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Two numbers are in the ratio 2½ : 3⅓. If 12 is added to each of them, the ratio becomes 7 : 9. What is the sum of the original numbers?</span></p>", "hi": ""}, "question_image": "", "quiz_id": "cgl-2026-tier2-mock9-hindi", "solution_heading": "", "solution_image": "", "solution_text": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Clear the mixed fractions first.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">2½ : 3⅓ = 5/2 : 10/3</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Multiply both by 6: </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">15 : 20 = 3 : 4</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Let the numbers be </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">3k and 4k</span><span style=\"font-family:'Cambria Math'\">.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">after adding the same number, cross-multiply with the new ratio.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">(3k + 12)/(4k + 12) = 7/9</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">9(3k + 12) = 7(4k + 12)</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">27k + 108 = 28k + 84</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">k = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">24</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">The original numbers.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">3k = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">72</span><span style=\"font-family:'Cambria Math'\">, 4k = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">96</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Sum = 72 + 96 = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">168</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Short trick.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Adding 12 to each does not change the difference: 4 − 3 = 1 part before, 9 − 7 = 2 parts after.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Make the difference equal: 3 : 4 = 6 : 8, and 6 : 8 → 7 : 9 means 1 part = 12.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Original sum = (6 + 8) × 12 = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">168</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Answer: </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">168</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-style:italic;font-family:'Cambria Math'\">192 is the sum after the 12s are added — read which pair of numbers the question asks about.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"text-decoration:underline;font-family:'Cambria Math'\">PYQ:</span><span style=\"font-family:'Cambria Math'\"> Similar question asked in </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">SSC CHSL 2025 Tier-I (18 Nov 2025, Shift 3)</span><span style=\"font-family:'Cambria Math'\"> with different values.</span></p>", "hi": ""}, "solution_video": "", "sortingparam": "0.00"}, {"answer": "3", "correct_score": "1", "deleted": "0", "difficulty_level": "0", "id": "50027", "negative_score": "1", "option_1": {"en": "<p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">(32.5, 0) and (62.5, 0)</span></p>", "hi": ""}, "option_2": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">(26.5, 8) and (68.5, 9)</span></p>", "hi": ""}, "option_3": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">(26.5, 0) and (68.5, 0)</span></p>", "hi": ""}, "option_4": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">(29.5, 0) and (65.5, 0)</span></p>", "hi": ""}, "option_5": "", "option_image_1": "", "option_image_2": "", "option_image_3": "", "option_image_4": "", "option_image_5": "", "question": {"en": "  <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Study the histogram and answer the question.</span></p><p style=\"margin-top:0pt;margin-bottom:0pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image073.png\" width=\"355\" height=\"231\" alt ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">The histogram above shows the weights (in kg) of 100 students. If the histogram is converted into a frequency polygon (line diagram), what will be the starting point and the end point of the polygon?</span></p>", "hi": ""}, "question_image": "", "quiz_id": "cgl-2026-tier2-mock9-hindi", "solution_heading": "", "solution_image": "", "solution_text": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Rule — a frequency polygon joins the class marks; it starts and ends on the x-axis at the class marks of an imaginary class before the first and after the last.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Class width from the inclusive classes.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">30–35 is followed by 36–41, so the true boundaries are </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">29.5–35.5</span><span style=\"font-family:'Cambria Math'\">, </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">35.5–41.5</span><span style=\"font-family:'Cambria Math'\">, …</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Width h = 35.5 − 29.5 = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">6</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">First and last class marks.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">First class mark = (30 + 35)/2 = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">32.5</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Last class mark = (60 + 65)/2 = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">62.5</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Add the imaginary classes, frequency 0.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Start = 32.5 − 6 = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">26.5</span><span style=\"font-family:'Cambria Math'\">, point </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">(26.5, 0)</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">End = 62.5 + 6 = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">68.5</span><span style=\"font-family:'Cambria Math'\">, point </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">(68.5, 0)</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Answer: </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">(26.5, 0) and (68.5, 0)</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-style:italic;font-family:'Cambria Math'\">(32.5, 8) and (62.5, 9) are the first and last vertices on the bars — the polygon itself begins one class width earlier, down on the axis.</span></p>", "hi": ""}, "solution_video": "", "sortingparam": "0.00"}, {"answer": "4", "correct_score": "1", "deleted": "0", "difficulty_level": "0", "id": "50028", "negative_score": "1", "option_1": {"en": "<p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">77</span></p>", "hi": ""}, "option_2": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">104</span></p>", "hi": ""}, "option_3": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">105</span></p>", "hi": ""}, "option_4": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">90</span></p>", "hi": ""}, "option_5": "", "option_image_1": "", "option_image_2": "", "option_image_3": "", "option_image_4": "", "option_image_5": "", "question": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">The sum of the interior angles of a regular polygon exceeds the sum of its exterior angles by 1980°. How many diagonals does the polygon have?</span></p>", "hi": ""}, "question_image": "", "quiz_id": "cgl-2026-tier2-mock9-hindi", "solution_heading": "", "solution_image": "", "solution_text": {"en": "  <p style=\"margin-top:2pt;margin-bottom:3pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image074.png\" width=\"188\" height=\"200\" alt ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Rule — interior-angle sum = (n − 2) × 180°; exterior-angle sum = 360° for every polygon.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Set up the equation.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">(n − 2) × 180 − 360 = 1980</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">(n − 2) × 180 = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">2,340</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">n − 2 = 13 ⇒ n = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">15</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Rule — number of diagonals = n(n − 3)/2.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">= 15 × 12/2 = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">90</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Answer: </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">90</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-style:italic;font-family:'Cambria Math'\">n(n − 1)/2 = 105 counts every pair of vertices — that includes the 15 sides, which are not diagonals.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"text-decoration:underline;font-family:'Cambria Math'\">PYQ:</span><span style=\"font-family:'Cambria Math'\"> Similar question asked in </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">SSC CGL 2022 Mains (Tier-II)</span><span style=\"font-family:'Cambria Math'\"> with different values.</span></p>", "hi": ""}, "solution_video": "", "sortingparam": "0.00"}, {"answer": "1", "correct_score": "1", "deleted": "0", "difficulty_level": "0", "id": "50029", "negative_score": "1", "option_1": {"en": "<p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">120(3 − √3) m</span></p>", "hi": ""}, "option_2": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">60√3 m</span></p>", "hi": ""}, "option_3": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">120(√3 − 1) m</span></p>", "hi": ""}, "option_4": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">120(3 + √3) m</span></p>", "hi": ""}, "option_5": "", "option_image_1": "", "option_image_2": "", "option_image_3": "", "option_image_4": "", "option_image_5": "", "question": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">A balloon is vertically above a straight horizontal road. From the balloon, the angles of depression of two milestones on the road, lying on opposite sides of the balloon, are 45° and 60°. If the milestones are 240 m apart, what is the height of the balloon above the road?</span></p>", "hi": ""}, "question_image": "", "quiz_id": "cgl-2026-tier2-mock9-hindi", "solution_heading": "", "solution_image": "", "solution_text": {"en": "  <p style=\"margin-top:2pt;margin-bottom:3pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image075.png\" width=\"244\" height=\"174\" alt ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"text-decoration:underline;font-family:'Cambria Math'\">Rule — angle of depression from the balloon = angle of elevation from the milestone.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">They are alternate angles, so ∠PAQ = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">45°</span><span style=\"font-family:'Cambria Math'\"> and ∠PBQ = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">60°</span><span style=\"font-family:'Cambria Math'\">.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Let P be the balloon, Q the point of the road directly below it, PQ = h.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"text-decoration:underline;font-family:'Cambria Math'\">Each base in terms of h.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image076.png\" width=\"140\" height=\"38\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image077.png\" width=\"171\" height=\"38\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"text-decoration:underline;font-family:'Cambria Math'\">Opposite sides — the two bases add up to AB.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image078.png\" width=\"126\" height=\"21\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image079.png\" width=\"131\" height=\"46\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image080.png\" width=\"118\" height=\"47\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"text-decoration:underline;font-family:'Cambria Math'\">Rationalise the denominator.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image081.png\" width=\"171\" height=\"42\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">= 120√3(√3 − 1)</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">= </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">120(3 − √3) m</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Answer: </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">120(3 − √3) m</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-style:italic;font-family:'Cambria Math'\">Opposite sides add the two bases; on the same side they would be subtracted — that one sign decides the question.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"text-decoration:underline;font-family:'Cambria Math'\">PYQ:</span><span style=\"font-family:'Cambria Math'\"> Similar question asked in </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">SSC CGL 2022 Mains (Tier-II)</span><span style=\"font-family:'Cambria Math'\"> with different values.</span></p>", "hi": ""}, "solution_video": "", "sortingparam": "0.00"}, {"answer": "2", "correct_score": "1", "deleted": "0", "difficulty_level": "0", "id": "50030", "negative_score": "1", "option_1": {"en": "<p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">37.5%</span></p>", "hi": ""}, "option_2": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">75%</span></p>", "hi": ""}, "option_3": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">50%</span></p>", "hi": ""}, "option_4": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">100%</span></p>", "hi": ""}, "option_5": "", "option_image_1": "", "option_image_2": "", "option_image_3": "", "option_image_4": "", "option_image_5": "", "question": {"en": " <p style=\"margin-top:1pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">A solid right circular cylinder of height 42 cm has a volume of 25,872 cm³. It is cut into 4 equal parts by 3 cuts parallel to its base. What is the percentage increase in the total surface area? (Take π = 22/7)</span></p>", "hi": ""}, "question_image": "", "quiz_id": "cgl-2026-tier2-mock9-hindi", "solution_heading": "", "solution_image": "", "solution_text": {"en": "  <p style=\"margin-top:2pt;margin-bottom:3pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image082.png\" width=\"188\" height=\"246\" alt ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Radius from the volume.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">πr²h = 25,872</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">22/7 × r² × 42 = 25,872</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">132 r² = 25,872 ⇒ r² = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">196</span><span style=\"font-family:'Cambria Math'\"> ⇒ r = </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">14 cm</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Rule — every cut parallel to the base creates two new circular faces.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">3 cuts ⇒ </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">6</span><span style=\"font-family:'Cambria Math'\"> new circles, each of area πr²</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Original total surface area.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">TSA = 2πr(h + r) = 2πr × 56</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Percentage increase.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image083.png\" width=\"75\" height=\"31\" alt style=\"vertical-align:middle\" ><span style=\"font-family:'Cambria Math'\"> </span><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image084.png\" width=\"56\" height=\"33\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><img src=\"https://static-appxdb-v2.akamai.net.in/website/bulk_uploader_images/1792671657844_image085.png\" width=\"243\" height=\"41\" alt style=\"vertical-align:middle\" ></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-family:'Cambria Math'\">Answer: </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">75%</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"font-style:italic;font-family:'Cambria Math'\">Each cut adds two faces, not one — counting 3 faces for 3 cuts halves the answer to 37.5%.</span></p><p style=\"margin-top:0pt;margin-bottom:1pt;font-size:12pt\"><span style=\"text-decoration:underline;font-family:'Cambria Math'\">PYQ:</span><span style=\"font-family:'Cambria Math'\"> Similar question asked in </span><span style=\"font-weight:bold;font-family:'Cambria Math'\">SSC CGL 2017 Mains (Tier-II)</span><span style=\"font-family:'Cambria Math'\"> with different values.</span></p>", "hi": ""}, "solution_video": "", "sortingparam": "0.00"}]}